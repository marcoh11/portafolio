---
import Icon from './Icon.astro';
import { PROFILE, type Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contacto" class="foot" data-contact>
  <div class="wrap foot-inner">
    <h2 class="foot-title">{t.foot.title}</h2>
    <a href={`mailto:${PROFILE.email}`} class="cta">
      {t.foot.cta}
      <Icon name="arrow" size={16} />
    </a>
    <nav aria-label={t.foot.social} class="social">
      <a href={PROFILE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      <a href={PROFILE.github} rel="noopener" target="_blank">GitHub</a>
      <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
      <a href={PROFILE.cv} download="MarcoHuanca-CV.pdf" class="cv">
        <Icon name="download" size={16} />{t.foot.cv}
      </a>
    </nav>
    <div class="legal">
      <span>© {year} Marco Huanca</span>
      <span>{t.foot.madeIn}</span>
    </div>
  </div>
</footer>

<style>
  .foot { background: var(--foot); color: #ffffff; }
  .foot-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
    padding-top: 120px;
    padding-bottom: 48px;
  }
  .foot-title {
    max-width: 900px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 4.6vw, 64px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 32px;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  .social {
    display: flex;
    gap: 16px 32px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 16px;
    color: #c8c8c8;
  }
  .cv { display: inline-flex; align-items: center; gap: 6px; }
  .legal {
    width: 100%;
    border-top: 1px solid #34363c;
    margin-top: 56px;
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 14px;
    color: #a3a3a3;
  }
  .foot :global(:focus-visible) { outline-color: #ffffff; }
  @media (max-width: 720px) {
    .foot-inner { padding-top: 80px; gap: 32px; }
    .legal { margin-top: 24px; justify-content: center; }
  }
</style>
