---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';


interface Photo { src: ImageMetadata; alt: string }
interface Props {
  photos: Photo[];
  /** Milisegundos que cada foto queda visible */
  interval?: number;
  class?: string;
  widths?: number[];
  sizes?: string;
}
const {
  photos,
  interval = 4500,
  class: cls,
  widths = [480, 720, 960],
  sizes = '(max-width: 720px) 100vw, 360px',
} = Astro.props;
---

<div class:list={['fade', cls]} data-photo-fade data-interval={interval}>
  {
    photos.map((p, i) => (
      <Image
        src={p.src}
        alt={p.alt}
        widths={widths}
        sizes={sizes}
        class:list={['slide', { 'is-active': i === 0 }]}
        aria-hidden={i === 0 ? undefined : 'true'}
        loading="lazy"
        decoding="async"
      />
    ))
  }
</div>

<style>
  .fade {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: var(--tile);
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .slide.is-active { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-photo-fade]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
      if (slides.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const interval = Number(root.dataset.interval) || 4500;
      let i = 0;
      let timer: number | undefined;

      const show = (next: number) => {
        slides[i].classList.remove('is-active');
        slides[i].setAttribute('aria-hidden', 'true');
        i = next;
        slides[i].classList.add('is-active');
        slides[i].removeAttribute('aria-hidden');
      };
      const start = () => {
        stop();
        timer = window.setInterval(() => show((i + 1) % slides.length), interval);
      };
      const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };

      // Solo rota cuando está en pantalla y la pestaña visible
      let inView = false;
      new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        inView && !document.hidden ? start() : stop();
      }).observe(root);
      document.addEventListener('visibilitychange', () => {
        inView && !document.hidden ? start() : stop();
      });
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
