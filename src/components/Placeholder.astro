---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Espacio reservado para una foto. Cuando tengas la imagen, ponla en src/assets/
 * e impórtala: <Placeholder src={miFoto} label="..." />  (Astro genera AVIF/WebP).
 */
interface Props {
  label: string;
  src?: ImageMetadata;
  class?: string;
  tone?: 'tile' | 'tile2' | 'dark';
  widths?: number[];
  sizes?: string;
}
const { label, src, class: cls, tone = 'tile', widths = [480, 720, 960], sizes = '(max-width: 720px) 100vw, 480px' } = Astro.props;
---

{
  src ? (
    <Image src={src} alt={label} class:list={['ph', 'ph--img', cls]} widths={widths} sizes={sizes} loading="lazy" decoding="async" />
  ) : (
    <div role="img" aria-label={label} class:list={['ph', `ph--${tone}`, cls]}>
      <span>{label}</span>
    </div>
  )
}

<style>
  .ph {
    border-radius: 12px;
    padding: 20px;
    overflow: hidden;
  }
  .ph--img { padding: 0; object-fit: cover; width: 100%; height: 100%; }
  .ph--tile { background: var(--tile); }
  .ph--tile2 { background: var(--tile2); }
  .ph--dark { background: #3a3a3a; }
  .ph span {
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ph--dark span { color: #d0d0d0; }
</style>
