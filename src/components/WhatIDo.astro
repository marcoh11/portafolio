---
import Placeholder from './Placeholder.astro';
import type { Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---

<section class="what" aria-labelledby="what-title">
  <div class="wrap what-inner">
    <div class="what-main">
      <h2 id="what-title" class="what-title">{t.what.title}</h2>
      <a href="#contacto" class="pill what-cta">{t.what.cta}</a>
      <ol class="services">
        {
          t.what.services.map((name, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="name">{name}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="what-art">
      <div class="stack-art">
        <div class="back" aria-hidden="true"></div>
        <Placeholder label={t.what.photo} tone="dark" class="front" />
      </div>
    </div>
  </div>
</section>

<style>
  .what { background: var(--ink); color: var(--ink-fg); }
  .what-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
    justify-content: space-between;
    padding-block: 96px;
  }
  .what-main { flex: 1 1 520px; min-width: 0; }
  .what-title {
    margin-bottom: 96px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(48px, 6vw, 88px);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .what-cta { margin-bottom: 32px; font-family: var(--font-sans); }
  .services { display: flex; flex-direction: column; gap: 6px; }
  .services li { display: flex; align-items: center; gap: 20px; }
  .num {
    flex: none;
    font-size: 14px;
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
  .name { font-size: clamp(26px, 3.4vw, 46px); font-weight: 300; line-height: 1.35; }

  .what-art { flex: 1 1 380px; min-width: 0; display: flex; justify-content: center; }
  .stack-art { position: relative; width: 100%; max-width: 480px; height: 520px; }
  .back {
    position: absolute;
    inset: 40px 30px 0 0;
    background: var(--ink-fg);
    border-radius: 10px;
    transform: rotate(-6deg);
  }
  .stack-art :global(.front) {
    position: absolute;
    inset: 0 0 40px 30px;
    border-radius: 10px;
    transform: rotate(4deg);
  }

  @media (max-width: 720px) {
    .what-inner { padding-block: 72px; gap: 48px; }
    .what-title { margin-bottom: 48px; }
    .stack-art { height: 400px; max-width: 340px; }
  }
</style>
