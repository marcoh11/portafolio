---
import { PROFILE, type Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
const words = PROFILE.typewriter;
---

<section id="inicio" class="wrap hero">
  <div class="hero-main">
    <p class="kicker"><span>{t.hero.eyebrow}</span><span>{t.hero.location}</span></p>
    <h1 class="title" aria-label={words.map((w) => `${w}.`).join(' ')}>
      <span aria-hidden="true" data-typewriter={JSON.stringify(words)}>{words[0]}</span><span class="caret" aria-hidden="true"></span>
    </h1>
  </div>
  <div class="hero-side">
    <p class="role">{t.hero.role}</p>
    <p class="serif lead">{t.hero.text}</p>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-typewriter]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    const words: string[] = JSON.parse(el.dataset.typewriter ?? '[]');
    let w = 0;
    let i = words[0]?.length ?? 0;
    let deleting = true;
    const tick = () => {
      let delay: number;
      if (deleting) {
        i -= 1;
        delay = 70;
        if (i <= 0) {
          i = 0;
          deleting = false;
          w = (w + 1) % words.length;
          delay = 450;
        }
      } else {
        i += 1;
        delay = 120;
        if (i >= words[w].length) {
          i = words[w].length;
          deleting = true;
          delay = 1800;
        }
      }
      el.textContent = words[w].slice(0, i);
      setTimeout(tick, delay);
    };
    setTimeout(tick, 1800);
  }
</script>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding-top: 160px;
    padding-bottom: 72px;
  }
  .hero-main { flex: 1 1 520px; min-width: 0; }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 32px;
    margin-bottom: 20px;
    font-size: 15px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(76px, 15vw, 232px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    min-height: 0.9em;
    white-space: nowrap;
  }
  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.78em;
    margin-left: 0.06em;
    vertical-align: -0.02em;
    background: var(--fg);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  .hero-side { flex: 0 1 460px; min-width: 0; padding-bottom: 16px; }
  .role {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.3px;
  }
  .lead { font-size: 21px; line-height: 1.55; color: var(--muted); }

  @media (max-width: 720px) {
    .hero { padding-top: 72px; padding-bottom: 48px; gap: 32px; }
    .hero-main, .hero-side { flex-basis: 100%; }
    .kicker { font-size: 13px; letter-spacing: 1px; }
    .role { font-size: 19px; }
    .lead { font-size: 18px; }
  }
</style>
