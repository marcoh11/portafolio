---
import {
  siAngular,
  siDocker,
  siLangchain,
  siLanggraph,
  siModelcontextprotocol,
  siOpenjdk,
  siPython,
} from 'simple-icons';
import { PROFILE, type Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;

/**
 * Íconos monocromos (fill/stroke = currentColor) para que sigan el tema.
 * Marcas oficiales vía simple-icons; AWS ya no publica sus logos ahí,
 * así que esos son glifos propios (reemplazables por los oficiales).
 */
type Glyph = { path: string } | { custom: string };
const ICONS: Record<string, Glyph> = {
  LangGraph: siLanggraph,
  LangChain: siLangchain,
  'Java 21': siOpenjdk,
  Python: siPython,
  Docker: siDocker,
  Angular: siAngular,
  MCP: siModelcontextprotocol,
  AWS: {
    custom:
      '<text x="12" y="13" text-anchor="middle" font-size="10.5" font-weight="800" font-family="Arial, Helvetica, sans-serif" fill="currentColor" stroke="none" letter-spacing="-0.3">aws</text>' +
      '<path d="M3.5 16.2c5 3 12 3 17 0" fill="none"/><path d="M18.2 14.9l2.5 1.2-1.1 2.5" fill="none"/>',
  },
  'Amazon Bedrock': {
    custom: '<path d="M12 3 2.5 8 12 13l9.5-5z"/><path d="M2.5 12.5 12 17.5l9.5-5"/><path d="M2.5 16.5 12 21.5l9.5-5"/>',
  },
  Lambda: {
    custom: '<rect x="2.5" y="2.5" width="19" height="19" rx="4"/><path d="M7.5 6.5h2.8l6.2 11M12.3 11.5 8 17.5"/>',
  },
  DynamoDB: {
    custom:
      '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"/><path d="M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13"/><path d="M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/>',
  },
};

const items = PROFILE.stack.map((name) => ({ name, icon: ICONS[name] }));
---

<section class="stack" aria-labelledby="stack-title">
  <div class="wrap stack-head">
    <h2 id="stack-title" class="stack-title">{t.stack.title}</h2>
    <p class="serif stack-text">{t.stack.text}</p>
  </div>
  <div class="marquee">
    <div class="track">
      {[false, true].map((hidden) => (
        <ul class="group" aria-hidden={hidden ? 'true' : undefined}>
          {items.map(({ name, icon }) => (
            <li>
              {icon && 'path' in icon && (
                <svg class="logo" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={icon.path} />
                </svg>
              )}
              {icon && 'custom' in icon && (
                <svg
                  class="logo"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  set:html={icon.custom}
                />
              )}
              <span>{name}</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .stack { padding-block: 72px; border-bottom: 1px solid var(--line); }
  .stack-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .stack-title { font-family: var(--font-display); font-weight: 400; font-size: 28px; }
  .stack-text { max-width: 520px; font-size: 18px; line-height: 1.55; color: var(--muted); }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track { display: flex; width: max-content; animation: marquee 30s linear infinite; }
  .track:hover { animation-play-state: paused; }
  .group { display: flex; align-items: center; gap: 72px; padding-right: 72px; }
  .group li {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.5px;
    white-space: nowrap;
  }
  .logo { width: 34px; height: 34px; flex: none; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (max-width: 720px) {
    .group { gap: 44px; padding-right: 44px; }
    .group li { font-size: 24px; gap: 10px; }
    .logo { width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .marquee { overflow-x: auto; }
  }
</style>
