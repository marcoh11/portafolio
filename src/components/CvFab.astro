---
import Icon from './Icon.astro';
import { PROFILE, type Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---

<a href={PROFILE.cv} download="MarcoHuanca-CV.pdf" class="fab" data-cv-fab aria-label={t.cv.label}>
  <span class="label" aria-hidden="true"><span>{t.cv.label}</span></span>
  <span class="circle"><Icon name="download" size={20} /></span>
</a>

<script>
  // Ocultar el botón flotante mientras la sección de contacto está visible.
  const fab = document.querySelector<HTMLElement>('[data-cv-fab]');
  const contact = document.querySelector('[data-contact]');
  if (fab && contact && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      fab.classList.toggle('is-hidden', entry.isIntersecting);
    }, { threshold: 0.15 }).observe(contact);
  }
</script>

<style>
  .fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    height: 56px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    /* Anillo sutil para que no se pierda sobre bloques del mismo color. */
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--bg) 40%, transparent),
      0 10px 30px rgb(0 0 0 / 0.22);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
    transition: transform .3s ease, opacity .3s ease, visibility .3s;
  }
  .fab:hover { opacity: 1; }
  .circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex: none;
  }
  /* El texto se despliega hacia la izquierda. */
  .label {
    display: grid;
    grid-template-columns: 0fr;
    overflow: hidden;
    white-space: nowrap;
    transition: grid-template-columns .35s cubic-bezier(.2, .8, .2, 1);
  }
  .label > span {
    min-width: 0;
    padding-left: 0;
    opacity: 0;
    transition: opacity .2s ease, padding .35s ease;
  }
  .fab:hover .label,
  .fab:focus-visible .label { grid-template-columns: 1fr; }
  .fab:hover .label > span,
  .fab:focus-visible .label > span { padding-left: 22px; opacity: 1; transition-delay: 0s, 0s; }

  .fab.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(.9);
  }
  @media (max-width: 720px) {
    .fab { right: 16px; bottom: 16px; height: 52px; }
    .circle { width: 52px; height: 52px; }
  }
</style>
